class Solution {
    public boolean isIsomorphic(String s, String t) {
        HashMap<Character,Character> hm=new HashMap<>();
        HashMap<Character, Character> map2 = new HashMap<>();
        boolean ans=true;
        for(int i=0;i<s.length();i++){
            char CharInS=s.charAt(i);
            char CharInT=t.charAt(i);
            // for s to t
            if(hm.containsKey(CharInS)){
                if(hm.get(CharInS)!=CharInT){
                    ans=false;
                    break;
                }
            }
            else{
                hm.put(CharInS,CharInT);
            }
            // for t to s

            if (map2.containsKey(CharInT)) {
                if (map2.get(CharInT) != CharInS) return false;
            }
        
           else {
            map2.put(CharInT, CharInS);
            }

        }
        return ans;
        
    }
}
