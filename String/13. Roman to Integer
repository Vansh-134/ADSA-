class Solution {
    public int romanToInt(String s) {
        Map<Character,Integer> hs=new HashMap<>();
        int ans=0;
        hs.put('I',1);
        hs.put('V',5);
        hs.put('X',10);
        hs.put('L',50);
        hs.put('C',100);
        hs.put('D',500);
        hs.put('M',1000);
         for (int i = 0; i < s.length(); i++) {
        int curr = hs.get(s.charAt(i));
        if (i + 1 < s.length() && curr < hs.get(s.charAt(i + 1))) {
            ans -= curr;
        } else {
            ans += curr;
        }
    }
        return ans;
    }
    }
