class Solution {
    public List<List<Integer>> fourSum(int[] nums, int target) {
        Arrays.sort(nums);
        List<List<Integer>> result=new ArrayList<>();
        int n=nums.length;
        for(int i=0;i<n;i++){
            if(i>0 && nums[i]==nums[i-1])continue;
            for(int j=i+1;j<n;j++){
                if(j>i+1 && nums[j]==nums[j-1])continue;
                int p=j+1;
                int q=n-1;
                while(p<q){
                    long ans=(long)nums[i]+nums[j]+nums[p]+nums[q];
                    if(ans==target){
                      result.add(List.of(nums[i], nums[j], nums[p], nums[q]));
                        p++;
                        q--;
                        while(p<q && nums[p]==nums[p-1])p++;
                    }
                    else if(ans<target){
                        p++;
                    }
                    else{
                        q--;
                    }
                }

            }
        }
        return result;
        
    }
}
