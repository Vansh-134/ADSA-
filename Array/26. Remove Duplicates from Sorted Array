class Solution {
    public int removeDuplicates(int[] nums) {
       int count=0;
        int n=nums.length;
        for(int i=0;i<nums.length;i++){
            if(i<=n-2 && nums[i]==nums[i+1]){
                continue;
            }
            else{
                nums[count]=nums[i];
                count++;
            }
        }
        return count;
        
    }
}
